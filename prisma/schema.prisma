
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum MembershipStatus {
  PENDING
  APPROVED
  EXPIRED
  REJECTED
}

model Teaching {
  id              String   @id @default(cuid())
  slug            String?  @unique
  youtubeUrl      String
  youtubeId       String   @unique
  thumbnailUrl    String?
  title           String
  titleAm         String?
  titleOm         String?
  description     String?  @db.Text
  descriptionAm   String?  @db.Text
  descriptionOm   String?  @db.Text
  durationSeconds Int?
  semesterLabel   String?
  scheduleLine    String?
  venueLine       String?
  position        Int      @default(0)
  published       Boolean  @default(true)
  membersOnly     Boolean  @default(false)
  attachments     TeachingAttachment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, position])
  @@index([membersOnly, published, position])
  @@index([slug])
  @@map("teachings")
}

model TeachingAttachment {
  id          String   @id @default(cuid())
  teachingId  String
  teaching    Teaching @relation(fields: [teachingId], references: [id], onDelete: Cascade)
  title       String?
  storagePath String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teachingId, createdAt])
  @@map("teaching_attachments")
}

model Blog {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  titleAm      String?
  titleOm      String?
  excerpt      String?    @db.Text
  excerptAm    String?    @db.Text
  excerptOm    String?    @db.Text
  content      Json
  contentAm    Json?
  contentOm    Json?
  coverImage   String?
  status       BlogStatus @default(DRAFT)
  publishedAt  DateTime?
  viewCount    Int        @default(0)
  membersOnly  Boolean    @default(false)
  attachments  BlogAttachment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([membersOnly, status, publishedAt])
  @@map("blogs")
}

model BlogAttachment {
  id          String   @id @default(cuid())
  blogId      String
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  title       String?
  storagePath String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([blogId, createdAt])
  @@map("blog_attachments")
}

model Event {
  id          String    @id @default(cuid())
  title       String?
  date        DateTime?
  imageUrl    String
  /** Object path within the Supabase Storage bucket (for delete/replace). */
  storagePath String?
  active      Boolean   @default(true)
  position    Int       @default(0)
  membersOnly Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, position])
  @@index([membersOnly, active, position])
  @@map("events")
}

model Manifesto {
  id        String   @id @default(cuid())
  content   Json
  updatedAt DateTime @updatedAt

  @@map("manifesto")
}

model MembershipRequest {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName    String
  email       String
  phone       String
  /// Telegram username without @
  telegram    String?
  message     String?          @db.Text
  status      MembershipStatus @default(PENDING)
  paymentMethod           String?
  paymentProofStoragePath String?
  paymentSubmittedAt      DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  rejectionReason       String?   @db.Text
  membershipStartsAt    DateTime?
  membershipExpiresAt   DateTime?
  renewedFromId         String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, status, createdAt])
  @@index([email, status, createdAt])
  @@unique([email, status])
  @@map("membership_requests")
}

model MembershipNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?  @db.Text
  type      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("membership_notifications")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  membershipRequests MembershipRequest[]
  membershipNotifications MembershipNotification[]
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
