# Copy to `.env` and fill values. Never commit `.env`.

# --- App URL (local dev) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Better Auth ---
# Use the same URL as your dev server.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of allowed origins.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Generate a strong secret for production; for local dev any random string works.
BETTER_AUTH_SECRET=change-me

# --- Database (Postgres) ---
# Local Postgres example (adjust user/password/db as needed).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Some tooling expects DIRECT_URL as a non-pooled connection string.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Admin ---
ADMIN_EMAIL=

# --- Cron (internal endpoints) ---
# Used to authorize cron calls such as membership expiry. Provide as header: x-cron-secret
CRON_SECRET=change-me

# --- Google OAuth (optional; required if using "Continue with Google") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In Google Cloud Console → Credentials → your OAuth client:
# Authorized redirect URIs must include exactly:
#   ${BETTER_AUTH_URL}/api/auth/callback/google
# Example local: http://localhost:3000/api/auth/callback/google

# --- SMTP (temporary email provider) ---
# Use this while Resend is paused (for example, when no verified sending domain is available yet).
# Gmail example:
# SMTP_SERVICE=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM_EMAIL=you@gmail.com
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
# Optional default recipient for `bun run test:email` (or pass email as CLI arg after --).
# TEST_EMAIL_TO=
# Optional Reply-To on the approval email (applicants see this when they hit "Reply").
# SMTP_REPLY_TO=
# MEMBERSHIP_REPLY_TO=

# --- Resend (future switch-back) ---
# Re-enable these when you have a verified sender domain in Resend, then swap transport code back.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Membership welcome email (sent when an admin approves a request) ---
# Optional subject line for "request received" confirmation.
# MEMBERSHIP_REQUEST_SUBJECT=
# Optional subject line (default is used if unset).
# MEMBERSHIP_APPROVAL_SUBJECT=
# --- Membership payment instructions (manual transfer) ---
# CBE (or primary bank) row on checkout
PAYMENT_METHOD_LABEL=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
# Telebirr row (optional; defaults shown if unset)
# PAYMENT_TELEBIRR_LABEL=Telebirr
# PAYMENT_TELEBIRR_ACCOUNT_NUMBER=
# PAYMENT_TELEBIRR_NOTES=
# PAYMENT_AMOUNT_BIRR=
# At least one URL is recommended so the email includes real links.
MEMBERSHIP_TELEGRAM_URL=
# Shown on checkout success and support CTAs (defaults to Telegram if unset).
# NEXT_PUBLIC_MEMBERSHIP_SUPPORT_URL=https://t.me/Eba_B
# MEMBERSHIP_SECONDARY_URL=
# MEMBERSHIP_SECONDARY_LABEL=
# Extra paragraphs (plain text; use a blank line between paragraphs).
# MEMBERSHIP_WELCOME_NOTES=
# Optional raw HTML block appended at the end (trusted admin-only content).
# MEMBERSHIP_WELCOME_EXTRA_HTML=

# --- YouTube (optional but recommended for video length + description) ---
# Create a key: Google Cloud Console → APIs & Services → Credentials → Create credentials → API key
# Restrictions: for local/server calls, use "Application restrictions: None" OR restrict only to YouTube Data API v3.
# The app reads, in order: YOUTUBE_DATA_API_KEY, then YOUTUBE_API_KEY, then GOOGLE_API_KEY.
YOUTUBE_DATA_API_KEY=

# --- Supabase (event posters) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Use your local Supabase service role key (from `supabase status` / local settings).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVENT_POSTERS_BUCKET=Event-posters

# --- Supabase (membership payment proof uploads) ---
# Recommended: a PRIVATE bucket. Admins view images using short-lived signed URLs.
SUPABASE_MEMBERSHIP_PAYMENTS_BUCKET=membership-payments

# --- Supabase (PDF attachments for teachings) ---
# Recommended: a PRIVATE bucket. Members download files using short-lived signed URLs.
SUPABASE_PDFS_BUCKET=pdfs
